PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=ledger_admin
PGPASSWORD=ledger_secret_password
PGDATABASE=ledger_db
PGPOOL_MAX=30

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_password

# Authentication & JWT
JWT_SECRET=your-secure-jwt-secret-key-here

